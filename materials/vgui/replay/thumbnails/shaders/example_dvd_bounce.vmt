screenspace_general
{
	$pixshader "dvd_bounce_ps20"
	
	$basetexture "vgui/replay/thumbnails/blank.vmt"
	$texture1    "vgui/replay/thumbnails/shaders/dvd_white.vtf"

	$x360appchooser 1
	$ignorez        1
	$fix_fb         32768
	"<dx90"
	{
		$no_draw 1
	}
		
	$copyalpha                 0
	$alpha_blend_color_overlay 0
	$alpha_blend               0
	$linearwrite               0
	$linearread_basetexture    0
	$linearread_texture1       0
	$linearread_texture2       0
	$linearread_texture3       0

	$c0_x	0.0  // time

	Proxies
	{
		Equals
		{
			srcVar1			$fix_fb
			resultVar		$flags2
		}
		CurrentTime
		{
			resultVar		$c0_x
		}
	}
}
